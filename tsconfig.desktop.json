{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./desktop/dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "desktop/**/*.ts",
    "shared/**/*.ts",
    "src/lib/parseAudioFilename.ts",
    "src/lib/buildAudioFilename.ts"
  ],
  "exclude": ["desktop/dist"]
}
